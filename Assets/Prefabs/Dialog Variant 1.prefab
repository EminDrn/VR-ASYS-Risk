  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "*\u015Eu anda bulundu\u011Funuz alan g\xFCvenli b\xF6lgedir.\n\n*Heyelan
    s\u0131ras\u0131nda a\xE7\u0131k, d\xFCz ve stabil zeminlerde bulunman\u0131z
    hayati \xF6nem ta\u015F\u0131r.\n\n*Heyelan; toprak ve kaya k\xFCtlelerinin e\u011Fimli
    arazilerde a\u015Fa\u011F\u0131 do\u011Fru hareket etmesiyle meydana gelir. Bu
    durum genellikle k\xFC\xE7\xFCk ta\u015F d\xFC\u015Fmeleri, \xE7atlama sesleri
    ve zemin kaymalar\u0131 ile kendini g\xF6sterir.\n\n*Heyelan an\u0131nda, kayma
    y\xF6n\xFCne dik a\xE7\u0131yla hareket ederek riskli b\xF6lgeden uzakla\u015Fman\u0131z
    gerekir.\n\n*Haz\u0131r oldu\u011Funuzda ileride bulunan kontrol panelini kullanarak
    heyelan\u0131 ba\u015Flat\u0131n\u0131z."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
